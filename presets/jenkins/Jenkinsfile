// Generated by `soroban-forge ci-init --provider jenkins`.
// Jenkins pipeline for {{project_name}} — mirrors the GitHub build-test preset.
pipeline {
    agent any

    environment {
        MAX_WASM_BYTES = '{{max_size}}'
    }

    stages {
        stage('Toolchain Setup') {
            steps {
                sh 'rustup toolchain install stable --profile minimal --target wasm32v1-none'
            }
        }

        stage('Build') {
            steps {
                sh 'cargo +stable build --target wasm32v1-none --release'
            }
        }

        stage('Test') {
            steps {
                sh 'cargo +stable test'
            }
        }

        stage('Size Check') {
            steps {
                sh '''
                    status=0
                    found=0
                    for wasm in target/wasm32v1-none/release/*.wasm; do
                        [ -e "$wasm" ] || continue
                        found=1
                        size_bytes=$(wc -c < "$wasm")
                        echo "$wasm: ${size_bytes} bytes (limit: ${MAX_WASM_BYTES} bytes)"
                        if [ "$size_bytes" -gt "$MAX_WASM_BYTES" ]; then
                            echo "$wasm exceeds the ${MAX_WASM_BYTES}-byte contract size limit"
                            status=1
                        fi
                    done
                    if [ "$found" -eq 0 ]; then
                        echo "no .wasm produced by the build"
                        status=1
                    fi
                    exit "$status"
                '''
            }
        }
    }
}
